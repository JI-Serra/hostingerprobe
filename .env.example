# This file contains only non-secret examples. Do not commit .env.local or hPanel values.
PROBE_ENV_MARKER=replace-with-a-non-secret-presence-marker
# Required secret. Configure only in Hostinger; send as `Authorization: Bearer <value>`.
PROBE_ACCESS_TOKEN=replace-in-hpanel-only

# Use a disposable database and restricted user. Record actual values in evidence, never here.
PROBE_MYSQL_SERVER=replace-with-database-host
PROBE_MYSQL_TCP=3306
PROBE_MYSQL_SCHEMA_MANUAL=replace-with-disposable-database-name
PROBE_DB_USER=replace-with-restricted-database-user
PROBE_DB_PASSWORD=replace-in-hpanel-only

# Optional safe correlation label for a scheduled run; this is not a secret.
PROBE_RUN_ID=replace-with-scheduled-run-label

# Set an absolute, writable, non-public path shared by the web process and scheduler.
PROBE_STATE_DIR_VERSION=replace-with-absolute-probe-state-directory
